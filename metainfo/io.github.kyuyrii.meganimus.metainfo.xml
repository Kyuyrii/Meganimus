<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.kyuyrii.meganimus</id>
  <url type="homepage">https://github.com/Kyuyrii/Meganimus</url>
  <url type="bugtracker">https://github.com/Kyuyrii/Meganimus/issues</url>
  <url type="vcs-browser">https://github.com/Kyuyrii/Meganimus</url>
  <developer id="io.github.kyuyrii">
    <name>Kyuyrii</name>
  </developer>
  <name>Meganimus</name>
  <summary>A game shortcut creator.</summary>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <display_length compare="ge">768</display_length>
  </recommends>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <content_rating type="oars-1.1"/>
  <categories>
    <category>Game</category>
    <category>Utility</category>
  </categories>
  <description>
    <p>
      A game shortcut creator. Making it easy to create shortcuts for native games, games that run via emulators, and games that run via Wine or UMU.
    </p>
  </description>
  <releases>
    <release version="5.1" date="2026-11-08">
      <description>
        <ul>
          <li>Added option to use a "Catppuccin Frappé" theme.</li>
          <li>Interface icons now come from QtAwesome.</li>
        </ul>
      </description>
    </release>
  </releases>
  <launchable type="desktop-id">io.github.kyuyrii.meganimus.desktop</launchable>
  <branding>
    <color type="primary" scheme_preference="light">#232634</color>
    <color type="primary" scheme_preference="dark">#232634</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <image width="1568" height="900">https://raw.githubusercontent.com/Kyuyrii/Meganimus/b49e2ad7989354d6022b4bc1fa94d6d8fd0e2121/metainfo/Meganimus_Lubuntu_KvArcDark.png</image>
      <caption>Meganimus on Lubuntu</caption>
    </screenshot>
  </screenshots>

</component>